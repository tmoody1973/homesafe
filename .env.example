# Copy to .env and fill in real passwords. .env is gitignored — never commit it.
#
# SSL NOTE — verified by experiment on 2026-08-13, do not "fix" this back:
#   These URLs deliberately OMIT sslrootcert=system.
#   psql understands `system` as "use the OS trust store".
#   node-postgres does NOT — it treats it as a filename and fails with
#   `ENOENT: no such file or directory, open 'system'`.
#   Our code connects via node-postgres, so the URL stays clean and
#   src/db/pool.ts passes ssl { rejectUnauthorized: true } explicitly.
#   For an ad-hoc psql session, append &sslrootcert=system to the URL.

# --- Migrations only. NEVER set this in Amplify or Lambda. -------------------
# `tarik` is an admin login. It stays local so the deployed app can never run
# with admin privileges. See docs/decisions/003-mcp-build-time-only.md.
DATABASE_URL_ADMIN=postgresql://tarik:PASSWORD@drying-gerbil-31622.j77.aws-us-east-2.cockroachlabs.cloud:26257/homesafe?sslmode=verify-full

# --- Application logins, created in Task 4 with scoped grants ---------------
# app_rw: case, consent, and memory data.
DATABASE_URL_APP=postgresql://app_rw:PASSWORD@drying-gerbil-31622.j77.aws-us-east-2.cockroachlabs.cloud:26257/homesafe?sslmode=verify-full
# evidence_ro: SELECT on the three public-evidence tables only.
DATABASE_URL_EVIDENCE=postgresql://evidence_ro:PASSWORD@drying-gerbil-31622.j77.aws-us-east-2.cockroachlabs.cloud:26257/homesafe?sslmode=verify-full

# --- AWS --------------------------------------------------------------------
AWS_REGION=us-east-1
